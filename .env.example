APP_MODE=mock
APP_CONFIG=./configs/config.example.yaml
# Live mode inventory (devices, exporters, topology, GeoIP overrides). Optional.
INVENTORY_FILE=

POSTGRES_DSN=postgres://ntv:ntv@localhost:5432/ntv?sslmode=disable
CLICKHOUSE_DSN=clickhouse://localhost:9000/ntv

# Optional
REDIS_ENABLED=false
REDIS_ADDRESS=localhost:6379

# GeoIP databases are not included in this package.
GEOIP_CITY_DB=./data/GeoLite2-City.mmdb
GEOIP_ASN_DB=./data/GeoLite2-ASN.mmdb

# Go API (cmd/api). Environment overrides the YAML config.
API_LISTEN=:8080
API_CORS_ALLOWED_ORIGINS=http://localhost:3000
MOCK_SEED=42
MOCK_SCENARIO=default
MOCK_SPEED=1

# sFlow collector (cmd/collector)
COLLECTOR_LISTEN=0.0.0.0:6343
COLLECTOR_METRICS_LISTEN=:9102
# Comma-separated addresses/CIDRs allowed to send sFlow (empty = all).
COLLECTOR_ALLOWED_SOURCES=
# > 0 prints normalized samples as JSON lines (sensitive; debugging only).
COLLECTOR_DEBUG_FLOWS_PER_SECOND=0

# Frontend (Next.js) — put these in apps/web/.env.local (Next.js reads env
# files from apps/web). NEXT_PUBLIC_* are inlined at build time.
#   mock: data generated in the browser (no API needed)
#   api:  data from the Go API at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_MOCK_SEED=42
NEXT_PUBLIC_MOCK_SCENARIO=default
NEXT_PUBLIC_MOCK_SPEED=1
