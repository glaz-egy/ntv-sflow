# Network Traffic Visualizer — Go binaries (one image, three commands):
#   ntv-api        REST + WebSocket API (mock mode)
#   ntv-collector  sFlow v5 UDP collector
#   ntv-sflow-gen  sends sFlow generated from the mock (demo/testing)
# Build context: repository root.

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN for c in api collector sflow-gen; do \
      CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ntv-$c ./cmd/$c || exit 1; \
    done

FROM alpine:3.22
RUN addgroup -S app && adduser -S app -G app
COPY --from=build /out/ /usr/local/bin/
COPY configs/config.example.yaml /etc/ntv/config.yaml
COPY configs/inventory.example.yaml configs/inventory.demo.yaml /etc/ntv/
ENV APP_CONFIG=/etc/ntv/config.yaml \
    API_LISTEN=:8080
USER app
EXPOSE 8080 6343/udp 9102
CMD ["ntv-api"]
